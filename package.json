{
  "name": "stratum",
  "description": "Distributed object storage at the edge with an S3-compatible API on Cloudflare Workers.",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:docker": "./deploy.sh",
    "deploy:vps": "./deploy.sh --vps",
    "db:init": "wrangler d1 execute stratum-db --local --file=src/storage/schema.sql",
    "db:init:remote": "wrangler d1 execute stratum-db --remote --file=src/storage/schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
